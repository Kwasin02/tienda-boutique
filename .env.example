# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local a Git.

# Tienda
STORE_NAME="Nombre de tu tienda"
STORE_URL="http://localhost:3000"
# Formato de precios (ej. es-CO / COP, es-MX / MXN, es-ES / EUR)
STORE_LOCALE="es-CO"
STORE_CURRENCY="COP"

# WhatsApp: solo dígitos, con código de país, sin + ni espacios. Vacío = botones ocultos.
WHATSAPP_NUMBER=""

