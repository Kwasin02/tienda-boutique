# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local a Git.

# Tienda
STORE_NAME="Nombre de tu tienda"
STORE_URL="http://localhost:3000"
# Formato de precios (ej. es-CO / COP, es-MX / MXN, es-ES / EUR)
STORE_LOCALE="es-CO"
STORE_CURRENCY="COP"

# WhatsApp: solo dígitos, con código de país, sin + ni espacios. Vacío = botones ocultos.
WHATSAPP_NUMBER=""

# Base de datos. SQLite en desarrollo; en producción, PostgreSQL (ver README).
DATABASE_URL="file:./database/dev.db"

# Firma de la sesión del administrador. Genera uno con: openssl rand -base64 48
SESSION_SECRET=""

# Primer administrador: lo crea `npm run db:seed`. Cambia la contraseña desde el panel después.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""   # mínimo 10 caracteres

# Tamaño máximo de cada foto subida (MB)
MAX_UPLOAD_MB="5"
# Carpeta donde se guardan las fotos (opcional; por defecto storage/uploads)
# UPLOAD_DIR=""
